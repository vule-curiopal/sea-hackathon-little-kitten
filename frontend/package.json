{
  "name": "miu-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "predev": "npm --prefix .. run build",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm --prefix .. run build",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts",
    "sync:artwork": "node tools/sync-artwork.mjs",
    "sync:growth": "node tools/export-growth-history.mjs",
    "demo:qr": "node --experimental-strip-types tools/export-demo-qr.mjs"
  },
  "dependencies": {
    "@miu/voice-client": "file:../packages/voice-client",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsqr": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
