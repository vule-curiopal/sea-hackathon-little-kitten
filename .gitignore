# Environment files, including nested and local variants
.env
.env.*
!.env.example

# Local editor and operating-system files
.idea/
.DS_Store

# Local dependencies and Python caches
node_modules/
.venv/
__pycache__/
*.py[cod]
dist/
*.tsbuildinfo
coverage/
.cache/voice-test-audio/
# Local checkout and packaging for hosted deployments
.site-deploy/
.cache/miu-deploy/

# Local PostgreSQL development storage
.miu-data/

# Runtime caches, temporary database copies, and browser tooling output
.cache/
/.miu-data-*/
/test-results/
/playwright-report/

# Ephemeral evaluation jobs and oversized raw replay output. Compact reports,
# manifests, curated acceptance evidence, source fixtures and stories stay visible.
/backend/evaluation/runs/*.log
/backend/evaluation/runs/**/*.log
/backend/evaluation/runs/real-100-*/
/backend/evaluation/runs/baseline-fake/transcripts.md
/backend/evaluation/runs/*.job.json
/backend/evaluation/runs/growing-real-year/
/backend/evaluation/runs/**/snapshots.jsonl
/backend/evaluation/runs/**/days.jsonl
