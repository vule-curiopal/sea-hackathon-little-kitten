# Copy values into your existing local .env; never commit real keys.
MIU_PROVIDER=fake
HOST=127.0.0.1
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Enable only behind a localhost reverse proxy that overwrites forwarded headers.
TRUST_PROXY_LOOPBACK=false

# Real mode requires both provider keys. Never expose them to the browser.
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
# Match LittleBuddy brain: 1 (default) omits the STT enable_logging query.
# 0 requests STT zero-retention mode; the current account returns 403 for it.
# This setting does not affect TTS or enable conversation memory in Miu.
STT_LOGGING=1
# Legacy STT-only alias: ELEVENLABS_ENABLE_LOGGING=true|false.
# If both flags are set, they must agree. Prefer STT_LOGGING for new configs.
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
OPENAI_BASE_URL=https://api.openai.com/v1
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID_VI=mgBpvrNosWzExdPuRbXP
ELEVENLABS_VOICE_ID_EN=fBD19tfE58bkETeiwUoC
OPENAI_MODEL=gpt-6-luna
OPENAI_MAX_OUTPUT_TOKENS=200
STT_TIMEOUT_MS=10000
REPLY_TIMEOUT_MS=10000
TTS_TIMEOUT_MS=10000
TURN_PROCESSING_TIMEOUT_MS=20000
FFPROBE_PATH=ffprobe
