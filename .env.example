# Copy values into your existing local .env; never commit real keys.
MIU_PROVIDER=real
VOICE_INPUT_MODE=elevenlabs_realtime
ELEVENLABS_VAD_SILENCE_MS=1000
HOST=127.0.0.1
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Enable only behind a localhost reverse proxy that overwrites forwarded headers.
TRUST_PROXY_LOOPBACK=false

# Real mode requires both provider keys. Never expose them to the browser.
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
# Match LittleBuddy brain: 1 omits enable_logging for batch and realtime STT.
# 0 requests zero-retention. Batch may reject it; realtime may warn instead.
# Realtime rejects a session if zero-retention was requested but not applied.
# This setting does not affect TTS or enable conversation memory in Miu.
STT_LOGGING=1
# Legacy STT-only alias: ELEVENLABS_ENABLE_LOGGING=true|false.
# If both flags are set, they must agree. Prefer STT_LOGGING for new configs.
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
OPENAI_BASE_URL=https://api.openai.com/v1
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID_VI=mgBpvrNosWzExdPuRbXP
ELEVENLABS_VOICE_ID_EN=fBD19tfE58bkETeiwUoC
OPENAI_MODEL=gpt-6-luna
OPENAI_MAX_OUTPUT_TOKENS=200
STT_TIMEOUT_MS=30000
REPLY_TIMEOUT_MS=10000
TTS_TIMEOUT_MS=30000
TURN_PROCESSING_TIMEOUT_MS=90000
FFPROBE_PATH=ffprobe

# Character engine and memory configuration
DEMO_MODE=true
MIU_DATA_DIR=.miu-data
OPENAI_CLASSIFY_MODEL=gpt-6-astra
OPENAI_REPLY_MODEL=gpt-6-astra
OPENAI_CHECK_MODEL=gpt-6-astra
OPENAI_MODERATION_MODEL=omni-moderation-latest
# Optional PostgreSQL server; otherwise use persistent local PGlite.
# DATABASE_URL=postgresql://miu:miu@localhost:5432/miu

# Remote PostgreSQL setup updates DATABASE_URL directly in this same .env.
SSH_HOST=
SSH_USER=
SSH_PASSWORD=
SSH_PORT=22
DATABASE_NAME=miu_character_memory
DATABASE_USER=miu_character_memory_app
DATABASE_SSH_TUNNEL=false
DATABASE_SSH_LOCAL_PORT=15432
DATABASE_SSH_REMOTE_PORT=5432
