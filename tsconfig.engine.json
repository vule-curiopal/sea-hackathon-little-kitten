{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist"
  },
  "include": [
    "backend/**/*.ts"
  ],
  "exclude": [
    "backend/pipeline/src",
    "backend/pipeline/test",
    "backend/pipeline/dist",
    "**/dist/**"
  ]
}
