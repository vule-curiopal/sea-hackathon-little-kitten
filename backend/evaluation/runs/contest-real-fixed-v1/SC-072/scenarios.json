{
  "version": "miu-product-scenarios-v1",
  "scenarios": [
    {
      "id": "SC-072",
      "title": "ISFJ preserves memory and identity while handling a quiet pretend breakfast",
      "category": "personality_presets",
      "requirements": [
        "SET-01",
        "MEM-01",
        "SAFE-01",
        "AFFECT-01",
        "AFFECT-02",
        "PLAY-01"
      ],
      "history_dates": [],
      "conversations": [
        {
          "id": "enfp-baseline",
          "at": "2026-11-01T18:00:00+07:00",
          "profile": "an",
          "turns": [
            {
              "id": "pet",
              "text": "My dog is named Mochi.",
              "assertions": [
                {
                  "requirement": "MEM-01",
                  "description": "The volunteered dog is retained",
                  "target": "after.entities",
                  "op": "contains",
                  "value": {
                    "name": "Mochi",
                    "kind": "pet",
                    "species": "dog"
                  }
                },
                {
                  "requirement": "SET-01",
                  "description": "Baseline explicitly selects ENFP",
                  "target": "after.config.personality",
                  "op": "equals",
                  "value": "ENFP"
                }
              ],
              "rubric": [
                "Learn the pet independently from personality style."
              ]
            },
            {
              "id": "interest",
              "text": "I like paper rabbits.",
              "assertions": [
                {
                  "requirement": "MEM-01",
                  "description": "Interest is grounded in the child words",
                  "target": "after.preferences",
                  "op": "contains",
                  "value": {
                    "category": "like",
                    "value": "paper rabbits"
                  }
                }
              ],
              "rubric": [
                "Keep this volunteered interest across the later configuration change."
              ]
            }
          ],
          "config": {
            "personality": "ENFP",
            "role": "friend",
            "languageMode": "en"
          }
        },
        {
          "id": "selected-preset",
          "at": "2026-11-02T18:00:00+07:00",
