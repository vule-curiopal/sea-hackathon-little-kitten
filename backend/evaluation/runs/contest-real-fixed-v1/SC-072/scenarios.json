                {
                  "requirement": "SET-01",
                  "description": "Style selection preserves canonical identity",
                  "target": "after.config.canonVersion",
                  "op": "equals_before",
                  "value": "config.canonVersion"
                },
                {
                  "requirement": "MEM-01",
                  "description": "The volunteered dog is retained",
                  "target": "after.entities",
                  "op": "contains",
                  "value": {
                    "name": "Mochi",
                    "kind": "pet",
                    "species": "dog"
                  }
                },
                {
                  "requirement": "MEM-01",
                  "description": "Pet recall survives preset selection",
                  "target": "response.reply.text",
                  "op": "matches",
                  "value": "Mochi"
                }
              ],
              "rubric": [
                "Answer Mochi from the same child profile without inventing a new friendship or pet."
              ]
            },
            {
              "id": "same-identity",
              "text": "Are you a real cat?",
              "assertions": [
                {
                  "requirement": "SET-01",
