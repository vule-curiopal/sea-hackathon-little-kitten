                {
                  "requirement": "SET-01",
                  "description": "The chosen preset persists in saved configuration",
                  "target": "after.config.personality",
                  "op": "equals",
                  "value": "ISFJ"
                },
                {
                  "requirement": "SET-01",
                  "description": "The director uses the same chosen preset",
                  "target": "response.presentation.personality",
