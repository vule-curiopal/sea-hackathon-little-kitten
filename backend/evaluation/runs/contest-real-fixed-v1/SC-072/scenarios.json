                  "requirement": "SET-01",
                  "description": "The chosen preset persists in saved configuration",
                  "target": "after.config.personality",
                  "op": "equals",
                  "value": "ISFJ"
                },
                {
                  "requirement": "SET-01",
                  "description": "The director uses the same chosen preset",
                  "target": "response.presentation.personality",
                  "op": "equals",
                  "value": "ISFJ"
                },
                {
                  "requirement": "SET-01",
                  "description": "Style selection preserves canonical identity",
                  "target": "after.config.canonVersion",
                  "op": "equals_before",
                  "value": "config.canonVersion"
                },
                {
                  "requirement": "AFFECT-02",
                  "description": "Explicit distress receives comfort",
