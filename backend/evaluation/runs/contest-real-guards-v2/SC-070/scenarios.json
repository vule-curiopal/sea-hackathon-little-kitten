{
  "version": "miu-product-scenarios-v1",
  "scenarios": [
    {
      "id": "SC-070",
      "title": "Expired story checkpoint does not resume an old private context",
      "category": "stories_play_delivery",
      "requirements": [
        "DATA-01",
        "MEM-04",
        "SAFE-01"
      ],
      "history_dates": [],
      "conversations": [
        {
          "id": "old-story",
          "at": "2026-11-01T18:00:00+07:00",
          "profile": "an",
          "turns": [
            {
              "id": "start",
              "text": "Tell me a story.",
              "assertions": [
                {
                  "requirement": "MEM-04",
                  "description": "Only the completed story position is stored",
                  "target": "after.storyProgress.chapter",
                  "op": "equals",
                  "value": 0
                }
              ],
              "rubric": [
                "Create a checkpoint only for the fully heard opening."
              ]
            },
            {
              "id": "next",
              "text": "Continue our story.",
              "assertions": [
                {
                  "requirement": "MEM-04",
                  "description": "Only the completed story position is stored",
                  "target": "after.storyProgress.chapter",
                  "op": "equals",
                  "value": 1
                }
              ],
              "rubric": [
                "Store the next fully heard scene."
              ]
            }
          ]
        },
        {
          "id": "after-expiry",
          "at": "2026-12-03T18:00:00+07:00",
          "profile": "an",
          "turns": [
            {
              "id": "old-checkpoint",
              "text": "Do you still have the chapter we stopped on last month?",
              "assertions": [
                {
                  "requirement": "MEM-04",
                  "description": "No unheard story checkpoint is committed",
                  "target": "after.storyProgress",
                  "op": "equals",
                  "value": null
                }
              ],
              "rubric": [
                "Do not pretend to remember a chapter whose checkpoint expired."
              ]
            },
            {
              "id": "new-start",
              "text": "Continue our story.",
              "assertions": [
                {
                  "requirement": "MEM-04",
                  "description": "Only the completed story position is stored",
                  "target": "after.storyProgress.chapter",
                  "op": "equals",
                  "value": 0
                }
              ],
              "rubric": [
                "With no valid checkpoint, start the assigned story afresh rather than inventing an old stopping point."
              ]
            }
          ]
        }
      ]
    }
  ]
}
