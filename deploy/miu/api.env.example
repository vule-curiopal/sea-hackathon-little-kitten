NODE_ENV=production
MIU_PROVIDER=real
# Requested demo login; startup links sam to the existing An test profile.
MIU_SEED_TEST_USER=true
OPENAI_MODEL=gpt-5.6-luna
OPENAI_CLASSIFY_MODEL=gpt-5.6-luna
OPENAI_REPLY_MODEL=gpt-5.6-luna
OPENAI_CHECK_MODEL=gpt-5.6-luna
# Normal STT logging matches LittleBuddy brain; zero-retention is opt-in.
STT_LOGGING=1
# Real mode defaults to elevenlabs_realtime; fake mode keeps rms_batch.
# VOICE_INPUT_MODE=elevenlabs_realtime
ELEVENLABS_VAD_SILENCE_MS=1000
HOST=127.0.0.1
PORT=4611
ALLOWED_ORIGINS=https://miu.curiopal.com
TRUST_PROXY_LOOPBACK=true
FFPROBE_PATH=/usr/bin/ffprobe
