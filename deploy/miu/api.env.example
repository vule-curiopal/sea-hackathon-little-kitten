NODE_ENV=production
MIU_PROVIDER=real
# Requested demo login; startup links sam to the existing An test profile.
MIU_SEED_TEST_USER=true
# Normal STT logging matches LittleBuddy brain; zero-retention is opt-in.
STT_LOGGING=1
HOST=127.0.0.1
PORT=4611
ALLOWED_ORIGINS=https://miu.curiopal.com
TRUST_PROXY_LOOPBACK=true
FFPROBE_PATH=/usr/bin/ffprobe
