NODE_ENV=production
MIU_PROVIDER=fake
# Normal STT logging matches LittleBuddy brain; zero-retention is opt-in.
STT_LOGGING=1
# Real mode defaults to elevenlabs_realtime; fake mode keeps rms_batch.
# VOICE_INPUT_MODE=elevenlabs_realtime
ELEVENLABS_VAD_SILENCE_MS=1000
HOST=127.0.0.1
PORT=4611
ALLOWED_ORIGINS=https://miu.curiopal.com
TRUST_PROXY_LOOPBACK=true
FFPROBE_PATH=/usr/bin/ffprobe
