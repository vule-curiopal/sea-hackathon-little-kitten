[Unit]
Description=Miu integrated character, memory and voice API
After=network.target

[Service]
Type=simple
User=miu
Group=miu
WorkingDirectory=/opt/miu/current
EnvironmentFile=/etc/miu/api.env
Environment=TSX_DISABLE_CACHE=1
ExecStart=/opt/node24/bin/node --import tsx /opt/miu/current/backend/integration/server.ts
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGTERM
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/opt/miu
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
MemoryMax=512M
CPUQuota=100%
TasksMax=128

[Install]
WantedBy=multi-user.target
